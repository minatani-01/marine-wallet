# Marine Wallet / Supabase
# Supabase ダッシュボード > Project Settings > API から取得する
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Marine Wallet / Google マップ（マップタブ）
# Google Cloud で鍵を2つ作り、Vercel の環境変数に入れる。リポジトリには置かない。
#   1) ブラウザ用（地図の表示）: Maps JavaScript API だけを許可し、
#      参照元を https://marine-wallet.vercel.app/* に絞る
#   2) サーバー用（座標の取得）: Geocoding API だけを許可する
# どちらも未設定なら地図は出ない（リストと「地図で開く」はそのまま使える）
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=
